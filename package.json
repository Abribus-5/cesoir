{
  "name": "cesoir",
  "version": "0.1.0",
  "description": "Ce soir ? Des idées de sorties à Paris quand tu ne sais pas quoi faire.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "dev": "node --watch-path=./server server/index.js",
